# Database (only applied when the postgres_data volume is first created)
POSTGRES_DB=your_database_name_here
POSTGRES_USER=your_database_user_here
POSTGRES_PASSWORD=your_secure_password_here

# Required - the app refuses to start without it. At least 32 characters, e.g.:
#   openssl rand -base64 48
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters-long-here

# AI description generator: set AI_CHAT_PROVIDER=openai and your key to enable it
AI_CHAT_PROVIDER=none
OPENAI_API_KEY=your-openai-api-key-here
