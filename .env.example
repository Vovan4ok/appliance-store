# Database (only applied when the postgres_data volume is first created)
POSTGRES_DB=your_database_name_here
POSTGRES_USER=your_database_user_here
POSTGRES_PASSWORD=your_secure_password_here

# Required - the app refuses to start without it. At least 32 characters, e.g.:
#   openssl rand -base64 48
JWT_SECRET=your-very-secure-jwt-secret-key-at-least-32-characters-long-here

# AI description generator: set AI_CHAT_PROVIDER=openai and your key to enable it
AI_CHAT_PROVIDER=none
OPENAI_API_KEY=your-openai-api-key-here

# Grafana login (http://localhost:3000); defaults to admin/admin, Grafana then asks to change it
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Real email through Brevo (free: 300 emails/day). Leave these out to keep using the local Mailpit inbox.
# Brevo → SMTP & API → SMTP: login and an SMTP key; MAIL_FROM must be a sender verified in Brevo (Senders & IP)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-smtp-login
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_FROM=you@example.com
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# IMPORTANT with the sample data: its accounts use real-looking addresses (phobos@gmail.com...) that belong to
# strangers, so send every email to your own inbox instead (the real recipient is shown in the subject):
# MAIL_REDIRECT_TO=you@example.com
